FROM php:7.4-fpm

RUN apt-get update && apt-get install -y \
    gettext \
    libpng-dev \
    locales \
    zip \
    && rm -rf /var/lib/apt/lists/*

COPY ./php-dev.ini /usr/local/etc/php/php.ini

RUN docker-php-ext-install mysqli gd gettext

COPY ./locale.gen /etc/locale.gen
RUN locale-gen && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.utf8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Do not copy source; dev volume mount will override at runtime
# COPY ./src/ /var/www/html/
# COPY ./html2pdf/ /html2pdf/

# Install Xdebug for development
RUN pecl install xdebug-3.1.6 && docker-php-ext-enable xdebug

# Copy custom Xdebug configuration (overrides defaults set by docker-php-ext-enable)
COPY ./xdebug.ini /usr/local/etc/php/conf.d/zz-xdebug.ini
